{
  "name": "releasehub-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-bundle-budget.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --passWithNoTests && node --test scripts/check-bundle-budget.test.mjs",
    "test:bundle-budget": "node --test scripts/check-bundle-budget.test.mjs",
    "test:delivery": "node --test scripts/nginx-cache-contract.test.mjs",
    "test:e2e": "playwright test",
    "generate:api": "orval --config orval.config.ts",
    "lint:api": "redocly lint ../API/openapi.yaml",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@ant-design/icons": "6.1.0",
    "@dagrejs/dagre": "^3.1.1",
    "@tanstack/react-query": "5.102.8",
    "@xyflow/react": "^12.11.6",
    "antd": "6.6.2",
    "i18next": "26.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.13",
    "react-router": "7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@redocly/cli": "2.49.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/dagre": "^0.7.54",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "jsdom": "30.0.1",
    "msw": "^2.15.0",
    "orval": "8.27.0",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
